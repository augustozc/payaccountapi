<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}} | PayAccount</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg site-nav">
        <div class="container">
            <a class="brand" href="/">pay<span>account</span></a>
            <div class="nav-meta">DEMO / 2026</div>
        </div>
    </nav>
    <main>
        {{#if success_msg}}<div class="container flash-wrap"><div class="alert alert-success">{{success_msg}}</div></div>{{/if}}
        {{#if error_msg}}<div class="container flash-wrap"><div class="alert alert-danger">{{error_msg}}</div></div>{{/if}}
        {{{body}}}
    </main>
    <footer class="site-footer"><div class="container d-flex justify-content-between"><span>PayAccount prototype</span><span>Saldo claro. Operação simples.</span></div></footer>
    <script src="/js/app.js"></script>
</body>
</html>
