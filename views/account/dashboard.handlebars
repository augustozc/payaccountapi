<section class="dashboard-shell container">
    <div class="dashboard-head"><div><p class="eyebrow">CONTA / VISÃO GERAL</p><h1>Olá, {{account.name}}.</h1><p class="muted">Sua conta está <strong class="status-active">ativa</strong> para esta demonstração.</p></div><form action="/account/logout" method="post"><button class="btn btn-outline-dark" type="submit">Encerrar sessão</button></form></div>
    <div class="balance-grid">
        <div class="balance-card"><div class="card-label">Saldo disponível <span class="live-dot"></span></div><div class="big-balance">{{currency account.balance}}</div><div class="balance-foot">Atualizado agora · conta demonstrativa</div></div>
        <div class="account-card"><div class="card-label">Titular</div><strong>{{account.name}}</strong><span>{{account.email}}</span><span>Conta criada em {{date account.createdAt}}</span></div>
    </div>
    <div class="operations-grid">
        <section class="operation-panel"><div class="section-heading compact"><p class="eyebrow">NOVO MOVIMENTO</p><h2>Registrar operação</h2></div><form action="/account/transactions" method="post"><div class="type-toggle"><label><input type="radio" name="type" value="credit" checked><span>Crédito</span></label><label><input type="radio" name="type" value="debit"><span>Débito</span></label></div><label for="amount">Valor</label><div class="money-input"><span>R$</span><input id="amount" name="amount" inputmode="decimal" placeholder="0,00" required></div><label for="description">Descrição</label><input id="description" name="description" type="text" placeholder="Ex.: recebimento, assinatura"><button class="btn btn-primary w-100" type="submit">Confirmar movimento <span>↗</span></button></form></section>
        <section class="statement-panel"><div class="section-heading compact"><p class="eyebrow">ATIVIDADE</p><h2>Extrato recente</h2></div>{{#if hasTransactions}}<div class="statement-list">{{#each transactions}}<div class="statement-row"><div class="movement-icon {{type}}">{{#if (eq type "credit")}}+{{else}}−{{/if}}</div><div class="movement-copy"><strong>{{description}}</strong><span>{{date createdAt}} · saldo {{currency balanceAfter}}</span></div><strong class="movement-amount {{type}}">{{#if (eq type "credit")}}+{{else}}−{{/if}}{{currency amount}}</strong></div>{{/each}}</div>{{else}}<div class="empty-state"><span>◎</span><p>Seu extrato está esperando o primeiro movimento.</p></div>{{/if}}</section>
    </div>
</section>
